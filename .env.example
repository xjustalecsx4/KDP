DATABASE_URL=postgresql://kdp:replace-me@localhost:5432/kdp
APP_URL=http://localhost:3000
AUTH_SECRET=
APP_ENCRYPTION_KEY=
STORAGE_PATH=./storage
FFMPEG_PATH=ffmpeg
REMOTION_BROWSER_EXECUTABLE=
APP_VERSION=0.1.0
GIT_COMMIT=
# Optional bearer token for detailed monitoring; /api/health always returns minimal status.
HEALTHCHECK_TOKEN=
# Phase 1 copy provider; template mode works offline. Keys stay server-side.
AI_PROVIDER=template
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Later publishing integration phases.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Enable only after Pinterest app approval, OAuth connection and a reviewed test.
PINTEREST_PUBLISHING_ENABLED=false
# APP_ENCRYPTION_KEY must be 64 hexadecimal characters (32 random bytes).

# Public SEO launch: keep disabled on local/staging installations.
# SITE_URL must be an HTTPS origin matching APP_URL, with no path.
SITE_URL=
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
